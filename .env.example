# MailVault Environment Variables
# Copy this file to .env.local and fill in your values

# ================================
# NextAuth Configuration
# ================================

# The base URL of your application
NEXTAUTH_URL=http://localhost:3000

# A random secret for encrypting session tokens
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-key-here

# ================================
# Google OAuth (for Gmail)
# ================================
# Get these from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Gmail API
# 3. Configure OAuth consent screen
# 4. Create OAuth 2.0 credentials
# 5. Add redirect URI: {NEXTAUTH_URL}/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================
# Azure AD OAuth (for Outlook)
# ================================
# Get these from: https://portal.azure.com/
# 1. Go to App registrations
# 2. Create new registration
# 3. Add redirect URI: {NEXTAUTH_URL}/api/auth/callback/azure-ad
# 4. Create client secret
# 5. Add API permissions: Mail.Read, Mail.ReadWrite, Files.ReadWrite

AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=common

# ================================
# Optional: Production Settings
# ================================

# Enable for production deployments
# NODE_ENV=production

# For Vercel deployment, set these in the Vercel dashboard
